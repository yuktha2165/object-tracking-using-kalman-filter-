# System Environment Configuration
ENV=development
HOST=0.0.0.0
PORT=8000

# Database Settings
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=traffic_monitoring

# Object Detection & Fine-tuned Model Settings
RTDETR_MODEL=rtdetr-l.pt
YOLO_MODEL=rtdetr-l.pt
CUSTOM_MODEL_PATH=backend/models/traffic_rtdetr_best.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45

# Tracking Parameters
MAX_MISSED_FRAMES=30
MAX_ASSOCIATION_DISTANCE=120.0
MAX_TRAJECTORY_POINTS=50

# Calibration & Analytics (Default values; can be overridden per video analysis job)
PIXELS_PER_METER=15.0
EXPECTED_DIRECTION=EAST
FRAME_SKIP=1
